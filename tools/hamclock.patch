  */
+/* influ: the picture in our_dir/influ-callbox.rgb565 over the whole box, if there is one of its
+ * size; return whether drawn.
+ */
+static bool drawCallPicture (void)
+{
+    const SBox &box = cs_info.box;
+    const int w = box.w*tft.SCALESZ, h = box.h*tft.SCALESZ;
+    std::string path = our_dir;
+    if (path.empty() || path.back() != '/')
+        path += '/';
+    FILE *fp = fopen ((path + "influ-callbox.rgb565").c_str(), "r");
+    if (!fp)
+        return (false);
+    std::vector<uint16_t> px (w*h);
+    bool whole = fread (px.data(), sizeof(uint16_t), px.size(), fp) == px.size() && fgetc (fp) == EOF;
+    fclose (fp);
+    if (!whole)
+        return (false);
+    for (int y = 0; y < h; y++)
+        for (int x = 0; x < w; x++)
+            tft.drawPixelRaw (box.x*tft.SCALESZ + x, box.y*tft.SCALESZ + y, px[y*w + x]);
+    return (true);
+}
