[Unit]
Description=influ scheduler - decides when the RTL-SDR may leave 1090 MHz
After=network-online.target

[Service]
EnvironmentFile=-%h/influ/scheduler/scheduler.env
ExecStart=%h/influ/.venv/bin/python %h/influ/scheduler/influ_scheduler.py $SCHED_ARGS
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
